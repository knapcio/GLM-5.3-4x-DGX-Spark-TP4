# Run from a workstation with Python 3, bash, ssh and rsync.
# Install weights and NCCL at identical absolute paths on all four hosts.
HOSTS=(NODE_1 NODE_2 NODE_3 NODE_4)
IPS=(DATA_ADDRESS_1 DATA_ADDRESS_2 DATA_ADDRESS_3 DATA_ADDRESS_4)
FABRIC_IFACE=enp1s0f0np0
IB_HCA=rocep1s0f0,roceP2p1s0f0
MODEL_DIR=/srv/glm/models/Tech2wild/GLM-5.3-Int4-Int8Mix
# Historical DSpark fallback path; native MTP does not mount or read it.
DRAFT_DIR=/srv/glm/models/RedHatAI/GLM-5.3-speculator.dspark
NCCL_HOST_DIR=/srv/glm/nccl-2.30.7
OVERLAY_REMOTE=/srv/glm/glm53-full-recipe
IMAGE=glm53-roce:v11-b58f34ea
# Experimental native MTP sampling (boot-time): GLM_SPEC_SAMPLE=0|1, default 0.
# Composed K-stop support exists; serving distribution qualification is still pending.
# Optional: pin an existing image by its local SHA256 ID on each host.
# IMAGES=(sha256:... sha256:... sha256:... sha256:...)
# Set after inspecting the local build; IDs can differ by node.
NCCL_SHA256=fba9b89b6f35b77a26efbc312f7af584fb776e8c2aa31f90c3714b066b097ce9,5cfc23157c67446ee7b512067e46741d386991926410c69336ccae95fb08201b,fba9b89b6f35b77a26efbc312f7af584fb776e8c2aa31f90c3714b066b097ce9,fba9b89b6f35b77a26efbc312f7af584fb776e8c2aa31f90c3714b066b097ce9
# One hash when all four binaries are identical, otherwise four comma-separated hashes in HOSTS order.
# Obtain these hashes from the installed libraries in the private deployment.
# Opt-in persistent compile cache (FlashInfer JIT, Triton, b12x, CUDA), one directory per node,
# outside every release tree. 1 = seed the fresh deployment cache from the generation keyed by
# image ID + FlashInfer version/arch + overlay hash, and save a new generation after admission.
RECIPE_PERSISTENT_CACHE=${RECIPE_PERSISTENT_CACHE:-0}
PERSISTENT_CACHE_DIR=${PERSISTENT_CACHE_DIR:-/srv/glm/glm53-full-compile-cache}
# Display-carveout KV: use require with RECIPE_MAX_MODEL_LEN=66112 for stack-1003.
# The reviewed ARM64 copy guard is required; see docs/runtime.md.
RECIPE_DISPRAM=${RECIPE_DISPRAM:-require}
DISPRAM_HOME=${DISPRAM_HOME:-/srv/glm-dispram}

# Selected stack-1003 layout; edit private .env for deployment paths and addresses.
RECIPE_MAX_MODEL_LEN=66112
GLM_INDEXER_SHORTCUT=1
DISPRAM_ALLOW_RM_ALLOC_OOM=1 # exact handled allocation line only; docs/runtime.md
GLM_PAD_HYGIENE=1
GLM_SPEC_SAMPLE=0
