# Copy to .env and fill site-specific values before running the launcher.
# Supply four unique management destinations and four fabric addresses, in rank order.
HOSTS=()
IPS=()
FABRIC_IFACE=
IB_HCA=
MODEL_DIR=
# Reserved unused draft path: keep distinct from MODEL_DIR, NCCL_HOST_DIR and OVERLAY_REMOTE.
DRAFT_DIR=/srv/glm-unused-draft
NCCL_HOST_DIR=
OVERLAY_REMOTE=
IMAGE=glm53-roce:v11-b58f34ea
# One binary SHA256 for identical builds, otherwise four comma-separated SHA256 values in rank order.
NCCL_SHA256=
DISPRAM_HOME=/srv/glm-dispram
RECIPE_DISPRAM=${RECIPE_DISPRAM:-require}
GLM_KV_FORMAT=${GLM_KV_FORMAT:-fp4x}
RECIPE_MAX_MODEL_LEN=${RECIPE_MAX_MODEL_LEN:-262144}
# FP8 remains selectable in this same profile: set both GLM_KV_FORMAT=fp8 and RECIPE_MAX_MODEL_LEN=66112.
# Boot-time changes require a drained restart.
RECIPE_PERSISTENT_CACHE=${RECIPE_PERSISTENT_CACHE:-0}
PERSISTENT_CACHE_DIR=${PERSISTENT_CACHE_DIR:-/srv/glm-compile-cache}
# Handled lender allocation-line exception used by the qualified launch; other fault checks stay active.
export DISPRAM_ALLOW_RM_ALLOC_OOM=1

RECIPE_KV_HEAD_BYTES=${RECIPE_KV_HEAD_BYTES:-6318718976}
GLM_ATTN_WEIGHTS=${GLM_ATTN_WEIGHTS:-nvfp4}
GLM_NVFP4_GROUPS=${GLM_NVFP4_GROUPS:-attn,shared,dense,mtp}
GLM_ATTN_NVFP4_DIR=
GLM_NVFP4_MORE_DIR=
GLM_FP4_RECENT_WINDOW=${GLM_FP4_RECENT_WINDOW:-0}
GLM_FP4_RECENT_AB=${GLM_FP4_RECENT_AB:-0}
# Opt-in only: WINDOW=2048, AB=1, INIT=0 reserves 986.2 MiB/rank even inactive.
# GLM_FP4_RECENT_INIT=0 VLLM_SERVER_DEV_MODE=1
GLM_LOADER=${GLM_LOADER:-fast} # coalesced is opt-in; fleet hash gate pending
RECIPE_PAGE_CACHE_POLICY=${RECIPE_PAGE_CACHE_POLICY:-0}
RECIPE_BOOT_PREFLIGHT=${RECIPE_BOOT_PREFLIGHT:-1}
# CPU-only advisory check runs only with an existing exact-path header cache.
RECIPE_BOOT_PREFLIGHT_HEADERS=
# RECIPE_BOOT_PREFLIGHT_IMAGE=already-installed-arm64-image

# Draft-only NVFP4 LM head defaults come from profiles/current.env (GLM_DRAFT_HEAD=nvfp4, GLM_DRAFT_HEAD_INIT=1).
# To boot without it set both GLM_DRAFT_HEAD=0 and GLM_DRAFT_HEAD_INIT=0.
# Decode/prefill time-slicing defaults come from profiles/current.env (ON, chunk 4096, decode_steps 40).
# Optional runtime control without a reboot: GLM_DECODE_FAIR_CONTROL=/cache/decode-fair.json
# (schema 2, written with scripts/decode_fair_control.py); see docs/time-slicing.md.
