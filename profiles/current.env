# Full GLM-5.3: native MTP with K-stop (up to three drafts), prefix caching, split32 MLA, switched RoCE.
export CUDA_CACHE_PATH='/cache/nv'
export FLASHINFER_CUDA_ARCH_LIST='12.1a'
export FLASHINFER_DISABLE_VERSION_CHECK='1'
export FLASHINFER_WORKSPACE_BASE='/cache/fi'
export GLM_DRAFT_LOWMEM='0'
export GLM_DSA_DRAFT_FOLD='0'
export GLM_DSA_SWA_POOL='0'
export GLM_FAST_LOAD='1'
export GLM_FAST_LOAD_AHEAD_MB='256'
export GLM_FAST_LOAD_DROP_CACHE='1'
export GLM_FAST_LOAD_SLAB_MB='64'
export GLM_FAST_LOAD_THREADS='4'
export GLM_FAST_LOAD_VERIFY='2'
export GLM_FLASH_SITECUSTOMIZE='/overlay/swa-pool/sitecustomize.py'
export GLM_FULL_MLA='triton'
export GLM_MAMBA_ALIGN_FIX='0'
export GLM_MLA_SPLIT_K='32'
export GLM_MLA_SPLIT_MAX_ROWS='36'
export GLM_ROCE_ALLREDUCE='1'
export GLM_TRITON_MLA_PREFILL='0'
export HF_HOME='/cache/hf'
export HF_HUB_DISABLE_IMPLICIT_TOKEN='1'
export HF_HUB_OFFLINE='1'
export LD_PRELOAD='/opt/nccl/libnccl.so.2.30.7'
export NCCL_BUFFSIZE='1048576'
export NCCL_CROSS_NIC='0'
export NCCL_CUMEM_ENABLE='0'
export NCCL_DEBUG='WARN'
export NCCL_IB_DISABLE='0'
export NCCL_IB_GID_INDEX='3'
export NCCL_IB_MERGE_NICS='0'
export NCCL_IB_ROCE_VERSION_NUM='2'
export NCCL_MAX_NCHANNELS='8'
export NCCL_NET='IB'
export NCCL_NET_PLUGIN='none'
export NCCL_NVLS_ENABLE='0'
export OMP_NUM_THREADS='1'
export PYTHONPATH='/overlay/bringup:/overlay/overlay'
export PYTORCH_CUDA_ALLOC_CONF='expandable_segments:True'
export TORCHINDUCTOR_CACHE_DIR='/cache/inductor'
export TORCH_CUDA_ARCH_LIST='12.1a'
export TRANSFORMERS_OFFLINE='1'
export TRITON_CACHE_DIR='/cache/triton'
export VLLM_CACHE_ROOT='/cache/vllm'
export VLLM_ENGINE_READY_TIMEOUT_S='3600'
export VLLM_NCCL_SO_PATH='/opt/nccl/libnccl.so.2.30.7'
export VLLM_USE_V2_MODEL_RUNNER='1'
export VLLM_WORKER_MULTIPROC_METHOD='spawn'
export XDG_CACHE_HOME='/cache'

# Qualified scheduler cap; constructor capacity stays4096 for the paired recipe.
export GLM_W2_PREFILL_CONTROL='/cache/d2w2-prefill-control.json'
export GLM_W2_PREFILL_CHUNK='2048'

# Native checkpoint MTP: packed quant mapping; no external drafter pool.
export GLM_MTP_FIX='1'

# Short-context DSA composed with K-stop in the qualified serving layout.
export GLM_INDEXER_SHORTCUT='1'

# Dirty-L2 fix: discard the consumed split32 MLA partials from L2 after the reduce (bit-identical output).
export GLM_DIRTY_L2='discard'

# Native MTP shard selection: the draft reads only the MTP-layer tensors (5 of 282 shards) and the
# target skips them; both pinned consumers discard those names unread (overlay/overlay/glm_mtp_select.py).
export GLM_MTP_ONLY_LOAD='1'
export GLM_TARGET_SKIP_MTP='1'

# Glue-lite (staged, default off): three Python-only launch removals, exact by construction (GPU gates in
# tests/gpu not yet run on the fleet), one switch each.
# The expected arming counts make a partial arming stop startup.
export GLM_GLUE_ROUTER_BF16='0'
export GLM_GLUE_MOE_WS='0'
export GLM_GLUE_DSA_IDX_CACHE='0'
export GLM_GLUE_ROUTER_EXPECT='target:75,mtp:1'
export GLM_GLUE_IDX_EXPECT='57'

# Native MTP K-stop: K3 at c1, K2 batches, graphs [1,4,12,16].
export GLM_MTP_KSTOP='1'
export GLM_MTP_KSTOP_CONTROL='/overlay/kstop/control.json'
# k2 (needs GLM_MTP_KSTOP=1) = multi-request batches draft two tokens per request: c2 verifies exact M6, c3 pads to M12,
# c4 replays M12 exactly. A lone request keeps confidence stopping. 1 drafts all three tokens in multi-request
# batches with [1, 4, 16]; 0 permits mixed lengths and eager target passes.
export GLM_MTP_KSTOP_UNIFORM_BATCH='k2'
# Remap graph-tail MoE routes to live row 0; default off until fleet A/B. Boot-time only.
export GLM_PAD_HYGIENE="${GLM_PAD_HYGIENE:-1}"
# reuse = dispatch the already captured M6 q3 at c2; m12 restores c2/c3 M12 padding.
# Both retain [1,4,12,16], all c1/c4 graphs and the same admitted memory charge.
export GLM_MTP_KSTOP_CAPTURE_LAYOUT="${GLM_MTP_KSTOP_CAPTURE_LAYOUT:-reuse}"

# Launch-shape switches (RECIPE_*): read by the launcher, never passed to the containers.
# Staged, default off until measured on the fleet (docs/history.md).
# 1 = capture a FULL graph at width 4 as well ([1, 3, 4, 6, 12]): the later MTP pass at c4 replays a graph.
export RECIPE_C4_PASS2_GRAPH='0'
# Serving capacity 262144 (2026-10-06 release gate; the earlier default was 165312 with a 3 GiB head / 2622 blocks).
export RECIPE_MAX_MODEL_LEN="${RECIPE_MAX_MODEL_LEN:-262144}"
# 1 = pin 2,543,549,952 B of target KV per rank (821 blocks, 2.369 GiB) instead of 2 GiB; context unchanged.
export RECIPE_KV_PIN_L1='0'
# 1 = NCCL_PROTO=^LL128 in every container: no LL128 buffers (about 0.44 GiB of pinned host memory per rank).
export RECIPE_NCCL_NO_LL128='0'
# Experimental headroom knobs; override in clone .env after this profile loads.
# 6318718976 B ordinary FP4x head = 4135 blocks (262144 + K3 lookahead needs 4098 + null). Earlier: 3221225472.
export RECIPE_KV_HEAD_BYTES="${RECIPE_KV_HEAD_BYTES:-6318718976}"
# Memory floors, GiB of MemAvailable per rank. 2026-10-06 memcliff: no harm under load down to 4.37 GiB (rank 0) and
# 4.12 (rank 1). 2026-10-07 ballast on the 262144 boot: no harm at rank-0 quiet 5.0 / 4.0 / 3.5 GiB (paired cycle,
# c4 burst, 120K prefill within 2 %, PSI ~0, no preemption) and at 3.5 on rank 1 (3.22 under load).
# Rule: live floor = lowest harmless level + 2.0; stress criterion = live + 0.5. Earlier values in parentheses.
# Live floor, any rank, boot and serving watch (6.0 on 2026-10-06; 6.0 before).
export RECIPE_LIVE_FLOOR_GIB="${RECIPE_LIVE_FLOOR_GIB:-5.5}"
# Launcher floor while CUDA graphs are captured, until health 200 (8.0).
export RECIPE_CAPTURE_HEADROOM_GIB="${RECIPE_CAPTURE_HEADROOM_GIB:-6.0}"
# Admission: all ranks at or above this for 60 continuous seconds after health 200 (8.0).
export RECIPE_ADMISSION_FLOOR_GIB="${RECIPE_ADMISSION_FLOOR_GIB:-6.5}"
# Release stress criterion: per-rank minimum during the max-length and c4 stress (6.4 on 2026-10-06; 8.4 before).
export RECIPE_STRESS_FLOOR_GIB="${RECIPE_STRESS_FLOOR_GIB:-6.0}"
# In-process refusal right before graph capture, read inside every rank (10.0).
export GLM_PRECAPTURE_FLOOR_GIB="${GLM_PRECAPTURE_FLOOR_GIB:-7.5}"
export RECIPE_PAGE_CACHE_POLICY='0'

# Experimental exact probabilistic MTP drafts; boot-time opt-in, needs GLM_MTP_KSTOP=0.
export GLM_SPEC_SAMPLE="${GLM_SPEC_SAMPLE:-0}"

# The MLA plan skip and its in-boot A/B mode are opt-in launch keys that this profile never exports; the launcher
# passes them only when they are set (docs/runtime.md, "Optional switches").

# Release layout. Sidecar host paths are supplied in .env and mounted read-only.
export GLM_KV_FORMAT="${GLM_KV_FORMAT:-fp4x}"
export RECIPE_DISPRAM="${RECIPE_DISPRAM:-require}"
export GLM_ATTN_WEIGHTS="${GLM_ATTN_WEIGHTS:-nvfp4}"
export GLM_NVFP4_GROUPS="${GLM_NVFP4_GROUPS:-attn,shared,dense,mtp}"
# No recent-FP8 bank or dev API in the default boot. Reserve only by explicit opt-in.
export GLM_FP4_RECENT_WINDOW="${GLM_FP4_RECENT_WINDOW:-0}"
export GLM_FP4_RECENT_AB="${GLM_FP4_RECENT_AB:-0}"
export GLM_LOADER="${GLM_LOADER:-fast}"
export RECIPE_BOOT_PREFLIGHT="${RECIPE_BOOT_PREFLIGHT:-1}"
